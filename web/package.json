{
  "name": "agent-platform-web",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "npm run cf-typegen && react-router dev",
    "build": "npm run cf-typegen && react-router build",
    "start": "wrangler dev",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run cf-typegen && tsc -b",
    "check": "npm run typecheck && react-router build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@react-router/dev": "7.9.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.136.1"
  }
}
