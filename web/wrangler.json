{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-platform-web-staging",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {},
  "previews": {
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "issues": {
        "enabled": false
      },
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  }
}
