APP_NAME=Receptionist + Outreach Agent Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_REGION=US
DEPLOYMENT_REGION_ID=us-east-1
DATABASE_REGION_ID=us-east-1
REDIS_REGION_ID=us-east-1
INBOUND_TENANT_ID=tenant-1
LEAD_BUSINESS_ID=

# Local service URLs only; no credentials are included.
DATABASE_URL=postgresql://localhost:5432/agent_platform
# Keep disabled until all regional rollout gates in ops/railway/README.md pass.
TENANT_REGION_ROUTING_ENABLED=false
# Required separate control database only when regional routing is enabled.
CONTROL_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Optional provider bootstrap. Keep credentials in the protected secret mount.
WORKER_BOOTSTRAP_MODULE=
PROVIDER_SECRETS_DIR=

# Exact browser origins allowed to call this API. Use a JSON array; no wildcards.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional environment-specific overrides: .env.development, .env.staging,
# or .env.production. Process environment variables take priority.

# Voice gateway (Cloudflare Worker) service key. Store ONLY the SHA-256 hex digest here; the Worker holds the key.
# Generate: python -c "import secrets,hashlib; k='vg_'+secrets.token_urlsafe(48); print('KEY (Worker secret PLATFORM_API_KEY):', k); print('VOICE_GATEWAY_KEY_SHA256=' + hashlib.sha256(k.encode()).hexdigest())"
# Unset disables GET /voice/resolve-number (it returns 503).
VOICE_GATEWAY_KEY_SHA256=

# Passwordless workspace sign-in. Use the exact HTTPS Cloudflare frontend origin
# and a sender address verified by the platform SendGrid account.
AUTH_PUBLIC_ORIGIN=
AUTH_EMAIL_FROM_EMAIL=
AUTH_EMAIL_API_KEY=
AUTH_MAGIC_LINK_TTL_SECONDS=600
AUTH_LOGIN_TICKET_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=43200
