APP_NAME=Receptionist + Outreach Agent Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_REGION=US
DEPLOYMENT_REGION_ID=us-east-1
DATABASE_REGION_ID=us-east-1
REDIS_REGION_ID=us-east-1
INBOUND_TENANT_ID=tenant-1
LEAD_BUSINESS_ID=

# Local service URLs only; no credentials are included.
DATABASE_URL=postgresql://localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# Optional provider bootstrap. Keep credentials in the protected secret mount.
WORKER_BOOTSTRAP_MODULE=
PROVIDER_SECRETS_DIR=

# Exact browser origins allowed to call this API. Use a JSON array; no wildcards.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional environment-specific overrides: .env.development, .env.staging,
# or .env.production. Process environment variables take priority.
