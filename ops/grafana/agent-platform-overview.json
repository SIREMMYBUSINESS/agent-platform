      "targets": [{"expr": "sum by (component, operation) (rate(platform_operations_total{outcome=~\"failed|failure|provider\"}[5m]))", "refId": "A"}],
      "title": "Application failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
