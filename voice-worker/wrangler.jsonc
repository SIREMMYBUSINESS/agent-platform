{
  "name": "agent-platform-voice",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "RECEPTIONIST", "class_name": "ReceptionistAgent" },
      { "name": "VOICE_ADMISSION", "class_name": "VoiceAdmission" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReceptionistAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["VoiceAdmission"] }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://agent-platform-voice.olaoluwaemmanuel6.workers.dev",
    "PLATFORM_API_URL": "https://agent-platform-staging.onrender.com"
  }
  // Runtime secrets are provisioned separately in Cloudflare:
  // PLATFORM_API_KEY, TWILIO_AUTH_TOKEN, TWILIO_ACCOUNT_SID, STREAM_SECRET
}
