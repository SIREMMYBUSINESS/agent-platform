{
  "name": "agent-platform-voice",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "RECEPTIONIST", "class_name": "ReceptionistAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReceptionistAgent"] }],
  "ratelimits": [
    { "name": "INCOMING_RATE_LIMITER", "namespace_id": "2026112601", "simple": { "limit": 60, "period": 60 } },
    { "name": "NUMBER_LOOKUP_RATE_LIMITER", "namespace_id": "2026112602", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://agent-platform-voice.olaoluwaemmanuel6.workers.dev",
    "PLATFORM_API_URL": "https://agent-platform-staging.onrender.com"
  }
  // Runtime secrets are provisioned separately in the staging Worker:
  // PLATFORM_API_KEY, TWILIO_AUTH_TOKEN, STREAM_SECRET
}
